# ═══════════════════════════════════════
# ChenEYE — .gitignore
# ═══════════════════════════════════════

# ── Dependencies ──
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ──
/.next/
/out/
next-env.d.ts

# ── Production build ──
/build
/dist

# ── Testing ──
/coverage

# ── Environment variables ──
.env
.env.*
!.env.example

# ── Vercel ──
.vercel

# ── TypeScript ──
*.tsbuildinfo

# ── Debug logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS files ──
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Misc ──
*.pem
*.log
build-output*.txt
build3.txt

# ── AI / Agent config (optional, remove if you want these tracked) ──
.gemini/
.agents/
.agent/
_agents/
_agent/
AGENTS.md
CLAUDE.md
